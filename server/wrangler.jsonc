{
  "name": "dark2048",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "observability": { "enabled": true },
  // `npx wrangler d1 create dark2048` prints the id to paste here
  "d1_databases": [
    { "binding": "DB", "database_name": "dark2048", "database_id": "PASTE_DATABASE_ID_HERE", "migrations_dir": "migrations" }
  ],
  "ratelimits": [
    { "name": "NEW_PLAYERS", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "WRITES", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ]
}
